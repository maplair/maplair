{
  "name": "maplair",
  "version": "4.0.0-alpha.2",
  "homepage": "https://maplair.org/",
  "description": "JavaScript library for mobile-friendly interactive maps",
  "author": "Volodymyr Agafonkin",
  "contributors": [
    "Iván Sánchez Ortega",
    "Dave Leaver",
    "Yohan Boniface",
    "Jon Koops",
    "Florian Bischof",
    "Per Liedman",
    "John Firebaugh",
    "Simon Legner"
  ],
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint-plugin-baseline-js": "^0.7.5",
    "markdown-it": "^15.0.3",
    "playwright": "^1.64.1",
    "prosthetic-hand": "^2.2.2",
    "typescript": "^6.0.3",
    "ui-event-simulator": "^2.0.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "types": "./dist/types/Maplair.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/Maplair.d.ts",
        "default": "./dist/esm/Maplair.js"
      },
      "default": {
        "types": "./dist/types/Maplair.all.d.ts",
        "default": "./dist/maplair-src.js"
      }
    },
    "./map-rotation": {
      "types": "./dist/types/map/Map.Rotation.d.ts",
      "default": "./dist/esm/map/Map.Rotation.js"
    },
    "./marker-rotation": {
      "types": "./dist/types/layer/marker/Marker.Rotation.d.ts",
      "default": "./dist/esm/layer/marker/Marker.Rotation.js"
    },
    "./marker-movement": {
      "types": "./dist/types/layer/marker/Marker.Move.d.ts",
      "default": "./dist/esm/layer/marker/Marker.Move.js"
    },
    "./dash-animation": {
      "types": "./dist/types/layer/vector/Path.DashAnimation.d.ts",
      "default": "./dist/esm/layer/vector/Path.DashAnimation.js"
    },
    "./path-decorations": {
      "types": "./dist/types/layer/vector/Polyline.Decorations.d.ts",
      "default": "./dist/esm/layer/vector/Polyline.Decorations.js"
    },
    "./geojson-loading": {
      "types": "./dist/types/layer/GeoJSON.Load.d.ts",
      "default": "./dist/esm/layer/GeoJSON.Load.js"
    },
    "./zoom-styles": {
      "types": "./dist/types/layer/vector/Path.ZoomStyles.d.ts",
      "default": "./dist/esm/layer/vector/Path.ZoomStyles.js"
    },
    "./src/": "./src/",
    "./styles.css": "./dist/maplair.css",
    "./i18n/*.json": "./i18n/*.json"
  },
  "style": "dist/maplair.css",
  "sideEffects": [
    "*.css",
    "./dist/maplair*.js",
    "./src/core/Handler.js",
    "./src/layer/GeoJSON.js",
    "./src/map/Map.js",
    "./src/map/Map.Rotation.js",
    "./src/layer/marker/Marker.Rotation.js",
    "./src/layer/marker/Marker.Move.js",
    "./src/layer/vector/Path.DashAnimation.js",
    "./src/layer/vector/Polyline.Decorations.js",
    "./src/layer/GeoJSON.Load.js",
    "./src/layer/vector/Path.ZoomStyles.js",
    "./dist/esm/core/Handler.js",
    "./dist/esm/layer/GeoJSON.js",
    "./dist/esm/map/Map.js",
    "./dist/esm/map/Map.Rotation.js",
    "./dist/esm/layer/marker/Marker.Rotation.js",
    "./dist/esm/layer/marker/Marker.Move.js",
    "./dist/esm/layer/vector/Path.DashAnimation.js",
    "./dist/esm/layer/vector/Polyline.Decorations.js",
    "./dist/esm/layer/GeoJSON.Load.js",
    "./dist/esm/layer/vector/Path.ZoomStyles.js"
  ],
  "files": [
    "dist",
    "src",
    "i18n",
    "!dist/maplair.zip",
    "CHANGELOG.md"
  ],
  "scripts": {
    "debug": "vp dev",
    "docs": "node ./build/types.js && node ./build/docs.js",
    "test": "vp test watch --project=chromium",
    "test:ui": "vp test watch --project=chromium --ui --browser.headless=false",
    "coverage": "vp test run --project=chromium --coverage",
    "build": "vp pack && node ./build/types.js",
    "test:tree-shaking": "node ./build/tree-shaking.js",
    "watch": "vp pack --watch",
    "lint": "vp lint",
    "lintfix": "vp lint --fix",
    "serve": "cd docs && bundle exec jekyll serve",
    "prepare": "vp config --no-agent",
    "i18n": "node ./build/i18n.js",
    "types": "node ./build/types.js",
    "types:check": "node ./build/types.js --check && node ./build/check-debug.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplair/maplair.git"
  },
  "keywords": [
    "gis",
    "map"
  ],
  "license": "BSD-2-Clause",
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  }
}
