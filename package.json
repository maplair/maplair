{
  "name": "maplair",
  "version": "2.0.0-alpha.1",
  "homepage": "https://maplair.org/",
  "description": "JavaScript library for mobile-friendly interactive maps",
  "author": "Volodymyr Agafonkin",
  "contributors": [
    "Iván Sánchez Ortega",
    "Dave Leaver",
    "Yohan Boniface",
    "Jon Koops",
    "Florian Bischof",
    "Per Liedman",
    "John Firebaugh",
    "Simon Legner"
  ],
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "eslint-plugin-baseline-js": "^0.7.0",
    "leafdoc": "^2.4.0",
    "playwright": "^1.62.0",
    "prosthetic-hand": "^2.2.2",
    "ui-event-simulator": "^2.0.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/Maplair.js",
      "default": "./dist/maplair-src.js"
    },
    "./src/": "./src/",
    "./styles.css": "./dist/maplair.css",
    "./i18n/*.json": "./i18n/*.json"
  },
  "style": "dist/maplair.css",
  "sideEffects": [
    "*.css",
    "./dist/maplair*.js",
    "./src/core/Handler.js",
    "./src/layer/GeoJSON.js",
    "./src/map/Map.js",
    "./dist/esm/core/Handler.js",
    "./dist/esm/layer/GeoJSON.js",
    "./dist/esm/map/Map.js"
  ],
  "files": [
    "dist",
    "src",
    "i18n",
    "!dist/maplair.zip",
    "!*.leafdoc",
    "CHANGELOG.md"
  ],
  "scripts": {
    "debug": "vp dev",
    "docs": "node ./build/docs.js",
    "test": "vp test watch --project=chromium",
    "test:ui": "vp test watch --project=chromium --ui --browser.headless=false",
    "coverage": "vp test run --project=chromium --coverage",
    "build": "vp pack",
    "watch": "vp pack --watch",
    "lint": "vp lint",
    "lintfix": "vp lint --fix",
    "serve": "cd docs && bundle exec jekyll serve",
    "prepare": "vp config --no-agent",
    "i18n": "node ./build/i18n.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplair/maplair.git"
  },
  "keywords": [
    "gis",
    "map"
  ],
  "license": "BSD-2-Clause"
}
